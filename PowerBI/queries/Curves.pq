let
    Encoded = Text.Combine({""}),
    Rows = Json.Document(Binary.Decompress(Binary.FromText(Encoded, BinaryEncoding.Base64), Compression.GZip)),
    Source = Table.FromRows(Rows, {"policy","reach_pct","selected","sms_n","control_n","sms_buyers","control_buyers","sms_rate","control_rate","uplift_pp","ci_low_pp","ci_high_pp","normalized_gain_pp"}),
    Typed = Table.TransformColumnTypes(Source, {{"policy", type text},{"reach_pct", Int64.Type},{"selected", Int64.Type},{"sms_n", Int64.Type},{"control_n", Int64.Type},{"sms_buyers", Int64.Type},{"control_buyers", Int64.Type},{"sms_rate", type number},{"control_rate", type number},{"uplift_pp", type number},{"ci_low_pp", type number},{"ci_high_pp", type number},{"normalized_gain_pp", type number}}, "en-US")
in
    Typed